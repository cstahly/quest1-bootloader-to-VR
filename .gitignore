*.img
*.sparse.img
*.raw
*.tar
*.tar.gz
*.tgz
*.apk
*.zip
*.gz

# --- Logs and raw captures (evidence lives in the workspace/backups, not here) ---
*.log
*.log.gz

# --- Compiled artifacts ---
*.o
*.out
monterey-head-mesh
monterey-head-mesh-fast
monterey-head-fov
monterey-head-tracking
test-lens-mesh
