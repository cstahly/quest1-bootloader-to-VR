pkgname=oculus-wifi-monterey
pkgver=0.1
pkgrel=2
pkgdesc="Guarded native Wi-Fi startup for Oculus Quest 1"
url="https://github.com/linux-msm/rmtfs"
arch="aarch64"
license="BSD-3-Clause"
depends="qrtr eudev-libs iw wpa_supplicant libqipcrtr4msmipc"
makedepends="qrtr-dev eudev-dev xz-dev"
_pd=5ecd2fe926aca7abfe40724177f63b942cff3947
_tftp=c2559a26098f6d2b36a946ef0b6ad02223264c3e
source="rmtfs-v1.3.tar.gz::https://codeload.github.com/linux-msm/rmtfs/tar.gz/refs/tags/v1.3
    pd-mapper-$_pd.tar.gz::https://codeload.github.com/linux-msm/pd-mapper/tar.gz/$_pd
    tqftpserv-$_tftp.tar.gz::https://codeload.github.com/linux-msm/tqftpserv/tar.gz/$_tftp
    0001-readonly-diagnostic-logging.patch
    0002-monterey-relative-buffer-offsets.patch
    0001-explicit-map-files.patch
    0001-msm-ipc-datagrams-and-wrq-ack.patch
    tqftp-translate-monterey.c
    test-sharedmem.c
    oculus-wifi
    oculus-wifi.initd"
builddir="$srcdir"
prepare() {
    patch -d "$srcdir/rmtfs-1.3" -p1 < "$srcdir/0001-readonly-diagnostic-logging.patch"
    patch -d "$srcdir/rmtfs-1.3" -p1 < "$srcdir/0002-monterey-relative-buffer-offsets.patch"
    patch -d "$srcdir/pd-mapper-$_pd" -p1 < "$srcdir/0001-explicit-map-files.patch"
    patch -d "$srcdir/tqftpserv-$_tftp" -p1 < "$srcdir/0001-msm-ipc-datagrams-and-wrq-ack.patch"
    cp "$srcdir/test-sharedmem.c" "$srcdir/rmtfs-1.3/"
}
build() {
    make -C "$srcdir/rmtfs-1.3"
    make -C "$srcdir/pd-mapper-$_pd"
    cc $CFLAGS "$srcdir/tqftpserv-$_tftp/tqftpserv.c" "$srcdir/tqftp-translate-monterey.c" $LDFLAGS -lqrtr -o "$srcdir/tqftpserv"
}
check() {
    cc $CFLAGS "$srcdir/rmtfs-1.3/test-sharedmem.c" $LDFLAGS -ludev -o "$srcdir/test-sharedmem"
    "$srcdir/test-sharedmem"
    sh -n "$srcdir/oculus-wifi" "$srcdir/oculus-wifi.initd"
}
package() {
    install -Dm755 "$srcdir/rmtfs-1.3/rmtfs" "$pkgdir/usr/libexec/oculus-wifi/rmtfs"
    install -Dm755 "$srcdir/pd-mapper-$_pd/pd-mapper" "$pkgdir/usr/libexec/oculus-wifi/pd-mapper"
    install -Dm755 "$srcdir/tqftpserv" "$pkgdir/usr/libexec/oculus-wifi/tqftpserv"
    install -Dm755 "$srcdir/oculus-wifi" "$pkgdir/usr/sbin/oculus-wifi"
    install -Dm755 "$srcdir/oculus-wifi.initd" "$pkgdir/etc/init.d/oculus-wifi"
}
