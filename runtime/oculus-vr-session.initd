#!/sbin/openrc-run
name="Oculus native VR session"
supervisor=supervise-daemon
command=/usr/bin/oculus-vr-session
output_log=/var/log/oculus-vr-session.log
error_log=/var/log/oculus-vr-session.log
respawn_delay=15
respawn_max=2
respawn_period=300
depend() {
 need localmount
 after oculus-stock-runtime oculus-device-access oculus-controller
}
