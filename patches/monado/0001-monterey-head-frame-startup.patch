+TEST_CASE("Monterey prediction respects head-local rotation after a yaw turn")
+{
+	const xrt_vec3 up{0,1,0}, gyro{1.01f,0,0}, bias{0.01f,0,0}, body{1,0,0};
+	xrt_space_relation relation{};
+	math_quat_from_angle_vector(1.57079632679f, &up, &relation.pose.orientation);
+	monterey_imu_world_angular_velocity(&relation.pose.orientation, &gyro, &bias, &relation.angular_velocity);
+	CHECK(relation.angular_velocity.x == Catch::Approx(0).margin(0.00001f));
+	CHECK(relation.angular_velocity.z == Catch::Approx(-1).margin(0.00001f));
+	relation.relation_flags = static_cast<xrt_space_relation_flags>(
+	    XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT);
+	xrt_space_relation predicted{};
+	m_predict_relation(&relation, 0.02, &predicted);
+	xrt_quat expected{};
+	math_quat_integrate_velocity(&relation.pose.orientation, &body, 0.02f, &expected);
+	CHECK(predicted.pose.orientation.x == Catch::Approx(expected.x).margin(0.00001f));
+	CHECK(predicted.pose.orientation.y == Catch::Approx(expected.y).margin(0.00001f));
+	CHECK(predicted.pose.orientation.z == Catch::Approx(expected.z).margin(0.00001f));
+	CHECK(predicted.pose.orientation.w == Catch::Approx(expected.w).margin(0.00001f));
+}
