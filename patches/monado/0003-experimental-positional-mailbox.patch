+/* File access is isolated from the high-rate orientation and pose callbacks. */
+static void *
+positional_thread(void *ptr)
+{
+ struct monterey_device *d = ptr;
+ os_thread_helper_lock(&d->vio_thread);
+ while (os_thread_helper_is_running_locked(&d->vio_thread)) {
+  os_thread_helper_unlock(&d->vio_thread);
+  struct mv_packet packet = {0};
+  bool present = mv_read_packet(d->vio_path, &packet);
+  os_mutex_lock(&d->fusion_mutex);
+  struct xrt_quat q = d->last_relation.pose.orientation;
+  struct xrt_vec3 w = d->last_relation.angular_velocity;
+  uint64_t now = os_monotonic_get_ns();
+  if (present && d->sample_count && now - d->last_update_ns < U_TIME_1S_IN_NS / 10) {
+   mv_update(&d->vio, packet, (struct mv_quat){q.x,q.y,q.z,q.w},
+             sqrt(w.x*w.x+w.y*w.y+w.z*w.z), now);
+  } else {
+   mv_deactivate(&d->vio, now); d->vio.anchored = false;
+  }
+  os_mutex_unlock(&d->fusion_mutex);
+  os_nanosleep(10 * U_TIME_1MS_IN_NS);
+  os_thread_helper_lock(&d->vio_thread);
+ }
+ os_thread_helper_unlock(&d->vio_thread);
+ return NULL;
+}
