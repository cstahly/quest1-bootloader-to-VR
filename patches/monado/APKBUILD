# Monado v25.1.0 with the guarded Oculus Quest 1 (Monterey) driver.
pkgname=monado-oculus-monterey
pkgver=25.1.0_git20260822
pkgrel=8
pkgdesc="Monado OpenXR runtime with guarded Oculus Monterey HMD support"
url="https://github.com/Block-Flock/monado-oculus-monterey"
arch="aarch64"
license="BSL-1.0"
depends="xr-hardware"
provides="monado=25.1.0"
replaces="monado"
makedepends="
	cmake
	cmd:glslangValidator
	cmd:wayland-scanner
	doxygen
	eigen-dev
	eudev-dev
	graphviz
	libbsd-dev
	libjpeg-turbo-dev
	libsurvive-dev
	libxrandr-dev
	mesa-dev
	opencv-dev
	openhmd-dev
	samurai
	sdl2-dev
	v4l-utils-dev
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	zlib-dev
	"
_commit=e160863ad52c0e1c29c8bb7df3e47facdb02288d
source="$pkgname-$_commit.tar.gz::https://github.com/Block-Flock/monado-oculus-monterey/archive/$_commit.tar.gz
	0001-monterey-head-frame-startup.patch
	0002-monterey-runtime-optics-framebuffer.patch
	0003-experimental-positional-mailbox.patch
"
builddir="$srcdir/$pkgname-$_commit"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DXRT_BUILD_DRIVER_MONTEREY=ON \
		-DXRT_FEATURE_WINDOW_PEEK=OFF \
		-DXRT_FEATURE_DEBUG_GUI=OFF
	cmake --build build
}

check() {
	# Keep the complete suite serial under crossdirect/QEMU.
	ctest --test-dir build -j1 --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	mkdir -p "$pkgdir"/etc/xdg/openxr/1
	ln -s /usr/share/openxr/1/openxr_monado.json \
		"$pkgdir"/etc/xdg/openxr/1/active_runtime.json
}

