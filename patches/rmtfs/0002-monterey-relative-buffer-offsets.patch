+/* Monterey firmware supplies byte offsets into the UIO region, not physical
+ * addresses. Opt in explicitly; other devices retain absolute addressing. */
+static int rmtfs_mem_offset(struct rmtfs_mem *rmem, unsigned long address,
+                           ssize_t len, uint64_t *offset)
+{
+    if (len < 0) return -EINVAL;
+    if (rmem->relative_offsets) {
+        *offset = address;
+    } else {
+        if (address < rmem->address) return -EINVAL;
+        *offset = address - rmem->address;
+    }
+    if (*offset > rmem->size || (uint64_t)len > rmem->size - *offset)
+        return -EINVAL;
+    return 0;
+}
+
+ssize_t rmtfs_mem_read(struct rmtfs_mem *rmem, unsigned long address, void *buf, ssize_t len)
+{
+    uint64_t offset;
+    if (rmtfs_mem_offset(rmem, address, len, &offset)) return -EINVAL;
+    if (rmem->base) {
+        memcpy(buf, (char *)rmem->base + offset, len);
+        return len;
+    }
+    return pread(rmem->fd, buf, len, offset);
+}
+
+ssize_t rmtfs_mem_write(struct rmtfs_mem *rmem, unsigned long address, const void *buf, ssize_t len)
+{
+    uint64_t offset;
+    if (rmtfs_mem_offset(rmem, address, len, &offset)) return -EINVAL;
+    if (rmem->base) {
+        memcpy((char *)rmem->base + offset, buf, len);
+        return len;
+    }
+    return pwrite(rmem->fd, buf, len, offset);
 }
 
