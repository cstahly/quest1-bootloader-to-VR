# Real values behind the placeholders used throughout the docs and tools.
# Copy to local.env (gitignored) and fill in. Never commit the filled-in copy;
# tools/check-pii.sh blocks the common shapes if you try.
LOCAL_USER=        # <user>             in /Users/<user>, /home/<user>, <user>@<BUILD_HOST_IP>
SERIAL=            # <SERIAL>           headset serial (`fastboot devices`)
BUILD_HOST_IP=     # <BUILD_HOST_IP>    Linux build host on your LAN
HEADSET_WIFI_IP=   # <HEADSET_WIFI_IP>  headset's DHCP address on Wi-Fi (varies)
LAN_GATEWAY_IP=    # <LAN_GATEWAY_IP>   your router
LAN_SUBNET=        # <LAN_SUBNET>       first three octets of your LAN, as in <LAN_SUBNET>.x
